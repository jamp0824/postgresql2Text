# ──────────────────────────────────────────────
# postgresql2Text — 환경변수 설정 예시
# 이 파일을 복사해서 .env 로 저장 후 값을 채우세요
# cp .env.example .env
# ──────────────────────────────────────────────

# [필수] Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# [필수] PostgreSQL 연결 정보
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mydb
PG_USER=postgres
PG_PASSWORD=your_password

# [선택] 사용할 Gemini 모델 (기본값: gemini-3.5-flash)
PG2TEXT_MODEL=gemini-3.5-flash

# [선택] 문서 저장 기본 디렉터리 (기본값: ./output)
PG2TEXT_OUTPUT_DIR=./output

# [선택] 로그 레벨 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
